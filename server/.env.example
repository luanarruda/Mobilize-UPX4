# Todas as variáveis são opcionais: o projeto roda sem este arquivo.
# Para usar, copie para .env e altere o que quiser.

PORT=3333
# Arquivo do banco SQLite (criado sozinho na primeira execução)
DB_ARQUIVO=dados/rotacerta.db
# De onde vêm as posições: "simulador" (padrão) ou "sptrans" (Etapa 6)
PROVEDOR=simulador
# Acelera o simulador (1 = tempo real). Útil em apresentações.
SIMULADOR_VELOCIDADE=1
