# Conexão com o PostgreSQL (ver docker-compose.yml na raiz)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rotacerta
PORT=3333
# De onde vêm as posições: "simulador" (padrão) ou "sptrans" (Etapa 6)
PROVEDOR=simulador
# Acelera o simulador (1 = tempo real). Útil em apresentações.
SIMULADOR_VELOCIDADE=1
